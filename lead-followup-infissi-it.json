    {
      "id": "007c3b21-9eea-4d14-a1e4-51201d2a3ee6",
      "name": "Pulisci e valuta lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        288
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// ---- CONFIG: adatta soglie e campi al tuo settore ----\nconst CONFIG = {\n  budgetMin: 5500,       // budget considerato \"serio\" (modificabile)\n  serramentiMin: 4,      // n. infissi che rende il lavoro interessante\n  hotThreshold: 70       // punteggio da cui il lead e' \"Alta\" priorita'\n};\n\nconst src = items[0]?.json?.body ?? items[0]?.json ?? {};\nconst clean = (v) => (v === undefined || v === null) ? '' : String(v).trim().replace(/\\s+/g, ' ');\nconst titleCase = (v) => clean(v).toLowerCase().replace(/(^|[\\s'’-])(\\S)/g, (m, a, b) => a + b.toUpperCase());\n\n// Legge importi all'italiana: \"3.500\", \"3.500,50\", \"3500\", \"3,5k\", \"€ 10.000\"\nfunction parseBudget(v) {\n  let s = clean(v).toLowerCase();\n  const mult = /k\\s*$/.test(s) ? 1000 : 1;\n  s = s.replace(/[^0-9.,]/g, '');\n  if (!s) return 0;\n  const hasDot = s.includes('.');\n  const hasComma = s.includes(',');\n  if (hasDot && hasComma) s = s.replace(/\\./g, '').replace(',', '.');\n  else if (hasComma) s = s.replace(',', '.');\n  else if (hasDot && /^\\d{1,3}(\\.\\d{3})+$/.test(s)) s = s.replace(/\\./g, '');\n  const n = parseFloat(s);\n  return Number.isFinite(n) ? n * mult : 0;\n}\n\nconst nome = titleCase(src.nome ?? src.first_name);\nconst cognome = titleCase(src.cognome ?? src.last_name);\nconst email = clean(src.email).toLowerCase();\nconst telefono = clean(src.telefono ?? src.phone);\nconst comune = titleCase(src.comune ?? src.city);\nconst tipo = clean(src.tipo_intervento ?? src.service_interest) || 'infissi';\nconst nInfissi = parseInt(clean(src.numero_infissi ?? src.windows_count), 10) || 0;\nconst budget = clean(src.budget);\nconst budgetNumero = parseBudget(budget);\nconst messaggio = clean(src.messaggio ?? src.message);\nconst fonte = clean(src.fonte ?? src.source) || 'Sito web';\n\nconst emailValida = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\nconst telefonoValido = telefono.replace(/\\D/g, '').length >= 8;\n\nlet punteggio = 0;\nif (telefonoValido) punteggio += 25;\nif (emailValida) punteggio += 15;\nif (budgetNumero >= CONFIG.budgetMin) punteggio += 25;\nif (nInfissi >= CONFIG.serramentiMin) punteggio += 20;\nif (messaggio.length > 30) punteggio += 15;\n\nconst lead_id = 'L' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 5).toUpperCase();\n\nreturn [{ json: {\n  lead_id,\n  created_at: new Date().toISOString(),\n  nome, cognome,\n  nome_completo: [nome, cognome].filter(Boolean).join(' ') || 'Contatto senza nome',\n  email, telefono, comune,\n  tipo_intervento: tipo,\n  numero_infissi: nInfissi || '',\n  budget, budget_numero: budgetNumero,\n  messaggio, fonte,\n  punteggio,\n  priorita: punteggio >= CONFIG.hotThreshold ? 'Alta' : 'Normale',\n  stato: 'Nuovo',\n  email_valida: emailValida\n} }];\n"
      }
