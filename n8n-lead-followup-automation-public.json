      "parameters": {
        "content": "2. Clean, Format, Score\n\nThis Code node makes the workflow reusable. Missing fields are safely converted to empty values, names are formatted, timestamps are added, and a simple lead score is calculated.",
        "height": 200,
        "width": 360,
        "color": 6
      },
      "id": "918f1659-4ccc-4188-825f-b0217979af15",
      "name": "Note - Data Normalization",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        32,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = items[0]?.json?.body ?? items[0]?.json ?? {};\n\nconst cleanText = (value) => {\n  if (value === undefined || value === null) return '';\n  return String(value).trim().replace(/\\s+/g, ' ');\n};\n\nconst titleCaseName = (value) => {\n  const cleaned = cleanText(value).toLowerCase();\n  if (!cleaned) return '';\n  return cleaned.replace(/\\b\\w/g, (char) => char.toUpperCase());\n};\n\nconst parseBudget = (value) => {\n  const cleaned = cleanText(value).replace(/[^0-9.,-]/g, '').replace(',', '.');\n  const parsed = Number.parseFloat(cleaned);\n  return Number.isFinite(parsed) ? parsed : 0;\n};\n\nconst firstName = titleCaseName(source.first_name);\nconst lastName = titleCaseName(source.last_name);\nconst fullName = [firstName, lastName].filter(Boolean).join(' ') || 'Unknown Lead';\nconst email = cleanText(source.email).toLowerCase();\nconst phone = cleanText(source.phone);\nconst company = cleanText(source.company);\nconst serviceInterest = cleanText(source.service_interest) || 'your request';\nconst budget = cleanText(source.budget);\nconst budgetNumber = parseBudget(budget);\nconst message = cleanText(source.message);\nconst leadSource = cleanText(source.source) || 'Unknown Source';\n\nlet leadScore = 0;\nif (phone) leadScore += 30;\nif (budgetNumber > 3000) leadScore += 30;\nif (message.length > 30) leadScore += 20;\nif (email) leadScore += 20;\n\nconst lead = {\n  first_name: firstName,\n  last_name: lastName,\n  full_name: fullName,\n  email,\n  phone,\n  company,\n  service_interest: serviceInterest,\n  budget,\n  message,\n  source: leadSource,\n  created_at: new Date().toISOString(),\n  lead_status: 'New',\n  lead_score: leadScore,\n  budget_number: budgetNumber\n};\n\nreturn [{ json: lead }];"
      },
